# Пример окружения бэкенда МАТА. Скопируй в .env при локальном запуске вне docker-compose
# (в compose dev-значения заданы там). ПЛЕЙСХОЛДЕРЫ — не настоящие ключи. Репозиторий
# ПУБЛИЧНЫЙ: настоящие секреты держи только в .env (он в .gitignore), НИКОГДА не коммить.
# Готовность к запуску проверяй командой:  python manage.py check_launch_readiness

# ─────────────────────────── DEV (по умолчанию) ───────────────────────────
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret-change-in-prod
POSTGRES_DB=kvartal
POSTGRES_USER=kvartal
POSTGRES_PASSWORD=kvartal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis: общий кэш (OTP/лимиты/бан/агрегаты) + брокер Celery. Без него — LocMem-кэш и
# Celery EAGER (задачи inline). Для прода с несколькими воркерами ОБЯЗАТЕЛЕН.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0   # по умолчанию берётся REDIS_URL

# ─────────────────────────── ПРОД (заполнить при деплое) ───────────────────────────
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<длинный-случайный, напр. `python -c "import secrets;print(secrets.token_urlsafe(50))"`>
# JWT_SECRET=<длинный-случайный, отдельный от DJANGO_SECRET_KEY>
# DJANGO_ALLOWED_HOSTS=api.mata-club.ru,mata-club.ru                  # хосты, с которых принимаем запросы
# DJANGO_CORS_ORIGINS=https://mata-club.ru,https://www.mata-club.ru   # источники сайта (со схемой)
# POSTGRES_PASSWORD=<сильный-пароль-БД>

# ─────────────── Внешние интеграции (каркасы готовы; включаются ключами) ───────────────
# Каждая интеграция в dev — no-op; активируется провайдером + ключами аккаунта владельца.
# Статус смотри: python manage.py check_launch_readiness

# Вход по одноразовому коду. Без SMS_PROVIDER код входа = 1234 (dev-режим).
#
# ОСНОВНОЙ путь — SIGMA ProPush (D-50): провайдер сам генерирует, доставляет
# и проверяет код, каскадом по каналам (SimPush в одно касание → flashcall → SMS).
# Часть каналов бескодовые: человек подтверждает вход кнопкой, вводить нечего.
# SMS_PROVIDER=propush
# SIGMA_TOKEN=<токен из кабинета user.sigmasms.ru → Настройки>
# SIGMA_WIDGET=<Widget ID, выдаёт менеджер SIGMA>
#
# ЗАПАСНОЙ путь — SIGMA messaging: код придумываем и проверяем мы сами,
# канал по умолчанию flashcall (последние 4 цифры звонящего номера).
# Widget ID для него не нужен. Проверен вживую.
# SMS_PROVIDER=sigma
# SIGMA_TOKEN=<тот же токен>
# SIGMA_CHANNEL=flashcall            # или sms (нужно зарегистрированное имя отправителя)
# SIGMA_FALLBACK=sms                 # канал, если основной не прошёл
#
# СТАРЫЙ путь — smsc.ru, оставлен на всякий случай.
# SMS_PROVIDER=smsc
# SMS_LOGIN=<логин smsc.ru>
# SMS_PASSWORD=<пароль/или API-ключ smsc.ru>
# SMS_SENDER=MATA                    # имя отправителя (согласуется у провайдера)

# Оплата заказов. Без PAYMENT_PROVIDER заказ считается «оплачено» (dev).
# PAYMENT_PROVIDER=yookassa
# YOOKASSA_SHOP_ID=<shopId ЮKassa>
# YOOKASSA_SECRET_KEY=<секретный ключ ЮKassa>

# Push-уведомления. Без PUSH_PROVIDER пуши — no-op (лента в приложении работает и так).
# PUSH_PROVIDER=rustore
# RUSTORE_PUSH_KEY=<сервисный ключ RuStore Push>
# FCM_SERVER_KEY=<ключ FCM, если используется Firebase вместо/вместе с RuStore>

# Мониторинг ошибок (Sentry self-host РФ, D-25). Без DSN — no-op.
# SENTRY_DSN=<dsn проекта Sentry>

# Медиа-хранилище (D-31). Без MEDIA_S3_* — локальный диск (dev). С ключами — S3/Object
# Storage (Yandex, S3-совместимый): аватары/фото отзывов/баннеры/лого клубов уходят туда,
# URL берётся из хранилища (можно отдавать через CDN-домен).
# MEDIA_S3_BUCKET=<имя бакета>
# MEDIA_S3_ACCESS_KEY=<access key сервисного аккаунта>
# MEDIA_S3_SECRET_KEY=<secret key>
# MEDIA_S3_ENDPOINT=https://storage.yandexcloud.net   # по умолчанию Yandex Object Storage
# MEDIA_S3_REGION=ru-central1
# MEDIA_S3_CUSTOM_DOMAIN=<cdn-домен без схемы, напр. cdn.mata-club.ru>   # опционально (CDN)

# ─────────────── Сроки хранения данных (152-ФЗ §2, авто-удаление; 0 = не удалять) ───────────────
# Чистит Celery beat ежедневно (команда cleanup_old_data). Лояльность/заказы/забеги не трогаются.
# ANALYTICS_EVENT_RETENTION_DAYS=365      # события аналитики старше N дней — удалять
# READ_NOTIFICATION_RETENTION_DAYS=90     # ПРОЧИТАННЫЕ уведомления старше N дней — удалять

# ─────────────── Прочее ───────────────
# SEED_DEMO_POINTS=1                 # выдавать демо-баллы новым аккаунтам (только для демо)
