# Nginx для бэкенда МАТА (прод). Скопировать в backend/nginx/mata.conf, подставить домен.
# TLS-сертификаты положить в backend/nginx/certs/ (fullchain.pem + privkey.pem).
# Проксирует API на web:8000, раздаёт /media и /static, форсит HTTPS.

# HTTP → HTTPS
server {
    listen 80;
    server_name api.mata-club.ru;
    # ACME-проверка Let's Encrypt при обновлении (deploy/tls.sh renew) — ОБЯЗАТЕЛЬНО
    # выше редиректа, иначе certbot получит 301 и обновление провалится.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.mata-club.ru;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 8m;   # загрузка фото (товары/логотип клуба ≤5 МБ)

    # Статика админки и медиа — отдаёт nginx, не Django. Django сюда не заходит,
    # поэтому его SECURE_CONTENT_TYPE_NOSNIFF на эти ответы НЕ распространяется —
    # заголовки ставим здесь.
    #
    # nosniff: браузер обязан верить заявленному Content-Type и не «принюхиваться»
    # к содержимому. Без него файл, загруженный пользователем (аватар, фото отзыва),
    # но содержащий HTML, был бы выполнен как страница НА НАШЕМ домене — хранимый XSS
    # с доступом к токену пользователя. Первый рубеж — проверка по сигнатуре файла
    # (common/uploads.py, D-37), это второй.
    #
    # ВАЖНО: add_header НЕ наследуется, если во вложенном location есть свой add_header.
    # Поэтому заголовки перечислены в каждом блоке, а не один раз на уровне server.
    location /static/ {
        alias /srv/static/;
        access_log off;
        expires 7d;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location /media/ {
        alias /srv/media/;
        access_log off;
        expires 7d;
        add_header X-Content-Type-Options "nosniff" always;
        # Открывать в браузере, но не позволять подменять тип через имя файла.
        add_header Content-Disposition "inline" always;
        # CORS: web-превью приложения (origin S3-бакета) рисует кросс-origin картинки
        # товаров через CanvasKit — без ACAO они не грузятся (tainted canvas). Медиа
        # публичное, поэтому "*" безопасно.
        add_header Access-Control-Allow-Origin "*" always;
    }

    # Конструктор (staff-only): загрузка видео-фона и медиа — большие файлы.
    # Общий лимит 8m держим для публичных загрузок (аватар/фото ≤5 МБ), тут поднимаем.
    location /admin/merch/ {
        client_max_body_size 300m;      # видео-фон блока (короткое, без звука)
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # ставим, не дописываем (аудит D03)
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;        # оптимизация видео может занять время
    }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        # Адрес клиента: nginx — граница, перед ним прокси нет. Оба заголовка ЗАДАЁМ
        # адресом соединения, а не дописываем к присланному: иначе клиент сам пишет
        # в X-Forwarded-For что угодно (аудит D03). Django берёт адрес из X-Real-IP
        # и только от своего прокси (common/clientip.py). Появится балансировщик/CDN
        # перед nginx — сначала set_real_ip_from + real_ip_header, потом менять это.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # ВАЖНО: Django доверяет этому заголовку для HTTPS (SECURE_PROXY_SSL_HEADER).
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ── САЙТ МАТА (статика) на корневом домене mata-club.ru ────────────────────────
# Файлы монтируются в /usr/share/nginx/site (docker-compose, из /opt/mata-site).
# Сертификат общий с API (fullchain.pem покрывает api.mata-club.ru + mata-club.ru).
server {
    listen 80;
    server_name mata-club.ru www.mata-club.ru;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://mata-club.ru$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name mata-club.ru www.mata-club.ru;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # www → без www (канонический адрес)
    if ($host = www.mata-club.ru) { return 301 https://mata-club.ru$request_uri; }

    root /usr/share/nginx/site;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
        add_header X-Content-Type-Options "nosniff" always;
        # Страницу всегда перепроверяем у сервера. В ней метки версий остальных
        # файлов (styles.css?v=…): если браузер оставит у себя старую страницу,
        # он и файлы возьмёт старые — владелец увидит вёрстку, которую мы уже
        # заменили. Сами файлы кэшировать можно: меняется содержимое → меняется
        # метка → меняется адрес (страж tools/check_site_cache_bust.py следит).
        add_header Cache-Control "no-cache" always;
        # CSP в режиме ТОЛЬКО НАБЛЮДЕНИЯ (Report-Only): браузер ничего не блокирует,
        # а пишет нарушения в консоль. Это первый шаг из docs/SECURITY_WEB_SESSION.md:
        # сначала убедиться, что политика не ломает сайт и Конструктор (iframe с
        # api.mata-club.ru), потом переименовать заголовок в Content-Security-Policy.
        # 'unsafe-inline' пока нужен: в index.html/app.html есть встроенные скрипты,
        # стили вешаются атрибутами. Одна строка — nginx не склеивает переносы.
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://api.mata-club.ru https://storage.yandexcloud.net https://*.storage.yandexcloud.net; media-src 'self' blob: https://api.mata-club.ru https://storage.yandexcloud.net https://*.storage.yandexcloud.net; connect-src 'self' https://api.mata-club.ru; frame-ancestors 'self' https://api.mata-club.ru; object-src 'none'; base-uri 'self'; form-action 'self'" always;
    }
}
