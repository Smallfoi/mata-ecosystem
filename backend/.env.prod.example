# Прод-окружение МАТА backend.
# СКОПИРОВАТЬ в backend/.env (он в .gitignore — НЕ коммитить!) и ЗАПОЛНИТЬ.
# Сильные секреты: python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Без заполнения секретов приложение НЕ стартует (fail-fast, common/prodcheck.py).

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=ЗАМЕНИ_сильным_секретом
JWT_SECRET=ЗАМЕНИ_ДРУГИМ_сильным_секретом
DJANGO_ALLOWED_HOSTS=api.mata-club.ru
# Откуда фронт/сайт ходят (CORS + CSRF для админки за HTTPS):
DJANGO_CORS_ORIGINS=https://mata-club.ru,https://www.mata-club.ru

# ── PostgreSQL/PostGIS ──────────────────────────────────────────────────────
POSTGRES_DB=mata
POSTGRES_USER=mata
POSTGRES_PASSWORD=ЗАМЕНИ_сильным_паролем_БД
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis (общий кэш: rate-limit/OTP/бан/баланс, D-07/D-28) ───────────────────
# Без REDIS_URL — LocMem (dev, один процесс). В проде ОБЯЗАТЕЛЕН (несколько воркеров).
REDIS_URL=redis://redis:6379/0

# ── Вход по коду: SIGMA messaging (D-50) ────────────────────────────────────
# Основной канал — flashcall: клиенту звонят, код = последние 4 цифры номера.
# Дешевле SMS и не требует регистрации имени отправителя.
# Токен — в кабинете user.sigmasms.ru (Настройки). В репозиторий НЕ коммитить.
# SMS_PROVIDER=sigma
# SIGMA_TOKEN=...
# SIGMA_CHANNEL=flashcall     # или sms (нужно зарегистрированное имя отправителя)
# SIGMA_SENDER=MATA           # имя отправителя для канала sms
# SIGMA_FALLBACK=             # запасной канал, если основной не отправился; пусто — не пробовать
# OTP_CODE_LENGTH=4           # поля ввода в приложениях и на сайте — на 4 символа
#
# ── Вариант 2: ProPush (тот же SIGMA, сервис аутентификации) ────────────────
# Отличие: код генерирует и проверяет ОН, а часть каналов бескодовые — человек
# подтверждает вход кнопкой на телефоне. Нужен Widget UUID от менеджера SIGMA;
# статический токен создаётся самостоятельно в кабинете → раздел «Токены».
# В настройках виджета указать наш IP: 158.160.12.117.
# SMS_PROVIDER=propush
# SIGMA_TOKEN=...
# SIGMA_WIDGET=...            # UUID виджета от менеджера
#
# Запасной провайдер (прежний): SMS_PROVIDER=smsc + SMS_LOGIN/SMS_PASSWORD.

# ── Медиа: объектное хранилище S3 (D-31) ─────────────────────────────────────
# Без ВСЕХ трёх обязательных ключей — локальный диск /srv/media (dev-режим).
# Yandex Object Storage: бакет + сервисный аккаунт с ролью storage.editor,
# статический ключ доступа (ID → ACCESS_KEY, секрет → SECRET_KEY).
# MEDIA_S3_BUCKET=mata-media
# MEDIA_S3_ACCESS_KEY=YCAJE...
# MEDIA_S3_SECRET_KEY=YCP...
# Ниже — необязательные (дефолты подходят для Yandex Object Storage):
# MEDIA_S3_ENDPOINT=https://storage.yandexcloud.net
# MEDIA_S3_REGION=ru-central1
# Домен CDN для отдачи медиа (без него URL идут прямо на бакет):
# MEDIA_S3_CUSTOM_DOMAIN=cdn.mata-club.ru

# ── Бэкапы БД в объектное хранилище (deploy/backup.sh) ───────────────────────
# Без BACKUP_S3_BUCKET дамп остаётся ТОЛЬКО на диске сервера (диск умрёт —
# умрут и БД, и бэкапы). Для прода задать ОБЯЗАТЕЛЬНО, бакет — приватный.
# BACKUP_S3_BUCKET=mata-backups
# Ключи по умолчанию берутся из MEDIA_S3_* — задать, если сервисный аккаунт другой:
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
# BACKUP_S3_REGION=ru-central1
# Сколько дней хранить локальные дампы (в бакете — политикой жизненного цикла):
# BACKUP_KEEP_DAYS=14
# Пароль шифрования дампа ПЕРЕД выгрузкой в бакет. В дампе телефоны, email, адреса и
# весь реестр баллов, а ключ к бакету лежит здесь же — без шифрования компрометация
# сервера означает чтение всех бэкапов. Пароль хранить ОТДЕЛЬНО от сервера
# (менеджер паролей): потеряете — восстановить бэкапы будет нечем.
# BACKUP_ENCRYPT_PASSPHRASE=

# ── TLS: Let's Encrypt (deploy/tls.sh) ───────────────────────────────────────
# TLS_DOMAIN=api.mata-club.ru
# TLS_EMAIL=admin@mata-club.ru

# ── Sentry (мониторинг/краши, D-25: self-host РФ) ────────────────────────────
# Без DSN Sentry не подключается (no-op). Заполнить, когда поднят self-host Sentry.
# SENTRY_DSN=https://<key>@sentry.mata-club.ru/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Оплата заказов (Store) ───────────────────────────────────────────────────
# Без PAYMENT_PROVIDER оплата не требуется (dev: заказ сразу «оплачен»).
# С ЮKassa: shopId и секретный ключ — из личного кабинета магазина.
# ВАЖНО: при заданном PAYMENT_PROVIDER, но пустых ключах оплата отдаёт 502 (а не
# молчаливый «pending») — заполнять всё вместе.
# PAYMENT_PROVIDER=yookassa
# YOOKASSA_SHOP_ID=...
# YOOKASSA_SECRET_KEY=...
# Куда вернуть покупателя после оплаты (обязательно для ЮKassa; приложение может
# прислать свой returnUrl, это — запасной):
# YOOKASSA_RETURN_URL=https://mata-club.ru/orders
#
# В личном кабинете ЮKassa (Интеграция → HTTP-уведомления) указать адрес вебхука:
#   https://api.mata-club.ru/v1/payments/webhook
# и включить события payment.succeeded и payment.canceled. Без вебхука заказы
# останутся в «ожидает оплаты», а баллы за покупку не начислятся.
# (Страховка на случай потерянного уведомления есть: GET /v1/orders/<id>/payment
# перепроверяет статус у ЮKassa и до-начисляет баллы.)
#
# Способ оплаты — только СБП (D-71). Ставки по договору ЮKassa: СБП ≈ 2,0%
# (оператор 0,4% + агрегатор 1,5%), карты/SberPay/T-Pay ≈ 4,4%. Включить все
# способы из кабинета — поставить any (без правки кода).
# PAYMENT_METHOD=sbp
#
# Чек по 54-ФЗ. Обязателен при ЛЮБОМ способе расчёта, включая СБП. Включать
# ТОЛЬКО после того, как к ЮKassa подключена онлайн-касса: с включённым чеком и
# без кассы платёж не создастся вовсе. Наш мерч (одежда, обувь) маркируется
# «Честным знаком» — касса нужна с ФФД 1.2 и модулем ТС ПИоТ, а в позициях
# должен уходить код маркировки (поле markCode в позиции заказа).
# PAYMENT_RECEIPT=1
# PAYMENT_TAX_SYSTEM=2   # 1 ОСН, 2 УСН доход, 3 УСН доход-расход, 5 ЕСХН, 6 патент
# PAYMENT_VAT_CODE=1     # 1 — без НДС (для УСН)

# ── Пуши вне приложения (D-25: RuStore Push / VK PNS) ────────────────────────
# Без PUSH_PROVIDER пуши не шлются (лента уведомлений в приложении работает и так).
# Оба значения — из RuStore Консоли: страница приложения → Push-уведомления → Проекты.
# PUSH_PROVIDER=rustore
# RUSTORE_PROJECT_ID=идентификатор_проекта
# RUSTORE_PUSH_KEY=сервисный_токен
# Протухшие токены устройств (приложение удалили) сервер чистит сам по ответу NOT_FOUND.

# ── Адреса витрины (конструктор + кнопка «Открыть сайт» в админке) ──────────
# SITE_PREVIEW_URL — что показывает конструктор в iframe.
# SITE_PUBLIC_URL  — куда ведёт «Открыть сайт»; если не задать, берётся превью.
SITE_PREVIEW_URL=https://mata-club.ru
# SITE_PUBLIC_URL=https://mata-club.ru

# ── Прочее ──────────────────────────────────────────────────────────────────
# Демо-баллы новичкам — в проде НЕ задавать (по умолчанию выкл). Только для демо: =1
# SEED_DEMO_POINTS=1
DJANGO_MEDIA_ROOT=/srv/media
DJANGO_STATIC_ROOT=/app/staticfiles
